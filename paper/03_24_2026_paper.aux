\@writefile{toc}{\contentsline {section}{\numberline {1}Results}{3}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Evaluation of the proposed physics-informed neural network (PINN) for soil moisture prediction, showing measured rainfall (\si {mm/h}), irrigation (\si {h/h}), potential evapotranspiration ($ET_0$, \si {mm/h}), and soil moisture (\si {\%VWC}) at depths of 5--55 \si {cm} over training and forecasting periods. Estimated soil moisture and plant water uptake (\si {\%VWC/h}) are also displayed for both periods. The PINN was trained using measured soil moisture data but estimates dynamics solely from initial conditions and external inputs (rain, irrigation, $ET_0$). In the forecasting phase, the model accurately predicts unseen data, demonstrating its viability for predictive control approaches that optimize water management.}}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{Mainfig}{{1}{4}{Evaluation of the proposed physics-informed neural network (PINN) for soil moisture prediction, showing measured rainfall (\si {mm/h}), irrigation (\si {h/h}), potential evapotranspiration ($ET_0$, \si {mm/h}), and soil moisture (\si {\%VWC}) at depths of 5--55 \si {cm} over training and forecasting periods. Estimated soil moisture and plant water uptake (\si {\%VWC/h}) are also displayed for both periods. The PINN was trained using measured soil moisture data but estimates dynamics solely from initial conditions and external inputs (rain, irrigation, $ET_0$). In the forecasting phase, the model accurately predicts unseen data, demonstrating its viability for predictive control approaches that optimize water management}{figure.caption.2}{}}
\citation{Franklin1998}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Heatmap and boxplot visualization of soil moisture estimation errors (\si {\%VWC}) across six depths (5 \si {cm} to 55 \si {cm}) during the training and forecasting periods. The heatmap displays error patterns, with red indicating positive errors, blue indicating negative errors, and white perfect estimation; the color scale spans from -2.5 to 11.1 \si {\%VWC}. The boxplots below show the error distributions for training and forecasting separately at each depth, highlighting medians near zero and interquartile ranges below 2.5 \si {\%VWC} for all cases.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{errorfig}{{2}{6}{Heatmap and boxplot visualization of soil moisture estimation errors (\si {\%VWC}) across six depths (5 \si {cm} to 55 \si {cm}) during the training and forecasting periods. The heatmap displays error patterns, with red indicating positive errors, blue indicating negative errors, and white perfect estimation; the color scale spans from -2.5 to 11.1 \si {\%VWC}. The boxplots below show the error distributions for training and forecasting separately at each depth, highlighting medians near zero and interquartile ranges below 2.5 \si {\%VWC} for all cases}{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Statistical analysis of soil moisture estimation across six soil layers, covering training and forecasting periods. RMSE is the root mean square error in \si {\%VWC}, SD is the standard deviation, and R² is the coefficient of determination. The obtained p-values indicate statistical significance ($p-values < 0.0001$). The overall result is obtained by analyzing the concatenated data from the six soil layers.}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:stats_combined}{{1}{6}{Statistical analysis of soil moisture estimation across six soil layers, covering training and forecasting periods. RMSE is the root mean square error in \si {\%VWC}, SD is the standard deviation, and R² is the coefficient of determination. The obtained p-values indicate statistical significance ($p-values < 0.0001$). The overall result is obtained by analyzing the concatenated data from the six soil layers}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Estimated flow functions describing the soil water dynamics across soil layers at 5 \si {cm} (first row), 15 \si {cm}, 25 \si {cm}, 35 \si {cm}, 45 \si {cm}, and 55 \si {cm}, where $fr_i(r)$ is the variation in \si {\%VWC/h} induced by rain, $f_i(m_i)$ is the vertical movement induced by soil moisture, inter-layer flow is the potential-driven movement between adjacent layers, plant uptake is related to soil moisture and potential evapotranspiration, $fl_i(m_i)$ is the lateral movement associated with respective soil moisture, and irrigation describes the increase in soil moisture in relation to the irrigation time in a unit of time. The shaded blue regions highlight the range of measured soil moisture data used for training.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{estimatedflows}{{3}{7}{Estimated flow functions describing the soil water dynamics across soil layers at 5 \si {cm} (first row), 15 \si {cm}, 25 \si {cm}, 35 \si {cm}, 45 \si {cm}, and 55 \si {cm}, where $fr_i(r)$ is the variation in \si {\%VWC/h} induced by rain, $f_i(m_i)$ is the vertical movement induced by soil moisture, inter-layer flow is the potential-driven movement between adjacent layers, plant uptake is related to soil moisture and potential evapotranspiration, $fl_i(m_i)$ is the lateral movement associated with respective soil moisture, and irrigation describes the increase in soil moisture in relation to the irrigation time in a unit of time. The shaded blue regions highlight the range of measured soil moisture data used for training}{figure.caption.6}{}}
